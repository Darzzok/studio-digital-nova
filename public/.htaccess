# Studio Digital Nova — configuration Apache / LiteSpeed pour l'export statique
# À placer à la racine du site sur Hostinger (public_html), aux côtés d'index.html.
#
# IMPORTANT : ce fichier n'est plus indispensable au fonctionnement du site.
# L'export est généré avec `trailingSlash`, donc chaque route possède son
# propre `index.html` (faq/index.html, blog/index.html…) que le serveur sert
# nativement. Si ce fichier venait à manquer, les pages resteraient
# accessibles — on perdrait seulement le cache, la compression et l'aperçu
# des images de partage.

DirectoryIndex index.html

# Next.js exporte les images Open Graph / Twitter Card sans extension
# (ex. /opengraph-image, /blog/mon-article/opengraph-image). Sans ça, Apache
# les sert sans Content-Type — LinkedIn, Facebook etc. ne peuvent alors pas
# afficher l'aperçu image du lien.
<IfModule mod_mime.c>
  <FilesMatch "^(opengraph-image|twitter-image)$">
    ForceType image/png
  </FilesMatch>
</IfModule>

# Page 404 personnalisée (générée par Next.js)
ErrorDocument 404 /404.html

# Compression des fichiers texte
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Mise en cache longue durée pour les assets statiques (noms de fichiers hashés par Next.js)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

# En-têtes de sécurité de base
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
